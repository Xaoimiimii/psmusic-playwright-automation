{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Lets the unit tests type-check against the .mjs tooling they test (scripts/triage); .mjs files are read for
    // their types only, not checked themselves.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "playwright.config.ts", "tests-unit/**/*.ts", "playwright.unit.config.ts"]
}
