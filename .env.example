# Copy to .env and fill in. .env is git-ignored; never commit the real service key.
# UI origin of the PSMusic SPA (Vite dev server). 5174 is used locally because 5173 is taken.
PSMUSIC_UI_URL=https://localhost:5174
# PSMusic API origin (ASP.NET Core, https profile). Paths under /api are added by the clients.
PSMUSIC_API_URL=https://localhost:7215
# Value of the X-App-Service-Key header (VITE_API_SIGNATURE in the client .env).
PSMUSIC_SERVICE_KEY=
# Optional name of the environment above (e.g. qa), shown in Allure and on the Xray Test Execution (docs/ci-cd.md §9).
PSMUSIC_ENVIRONMENT=
# Optional: an API response slower than this many ms is recorded as a slow-response failure signal (default 4000).
PSMUSIC_SLOW_RESPONSE_MS=

# --- Jira / Xray integration (docs/integrations/authentication-and-security.md) ---
# Only ATLASSIAN_SITE_URL is read by the Playwright run (optional): with it, Allure results link to their
# Xray Test, stories, risks and bugs (docs/reporting.md). The rest is for the Jira/Xray commands and scripts.
# Jira site, e.g. https://<site>.atlassian.net (REST fallback and Allure links; MCP uses OAuth).
ATLASSIAN_SITE_URL=
# Cloud ID from the MCP tool getAccessibleAtlassianResources (needed with scoped API tokens).
ATLASSIAN_CLOUD_ID=
# Target Jira project key; must match test-management/config/project-map.json.
JIRA_PROJECT_KEY=
# REST fallback credentials (secret). Classic or scoped API token from id.atlassian.com.
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
# Xray Cloud API key (secret), created by a Jira admin in Xray Global Settings > API Keys.
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
