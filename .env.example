# Copy to .env and fill in. .env is git-ignored; never commit the real service key.
# UI origin of the PSMusic SPA (Vite dev server). 5174 is used locally because 5173 is taken.
PSMUSIC_UI_URL=https://localhost:5174
# PSMusic API origin (ASP.NET Core, https profile). Paths under /api are added by the clients.
PSMUSIC_API_URL=https://localhost:7215
# Value of the X-App-Service-Key header (VITE_API_SIGNATURE in the client .env).
PSMUSIC_SERVICE_KEY=
